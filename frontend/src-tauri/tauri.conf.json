{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WORKAPOS Terminal",
  "version": "0.1.0",
  "identifier": "id.workapos.terminal",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WORKAPOS Terminal",
        "width": 1366,
        "height": 768,
        "minWidth": 1024,
        "minHeight": 600,
        "maximized": true,
        "resizable": true,
        "decorations": false,
        "fullscreen": false,
        "backgroundColor": "#f4f6fb"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Business",
    "shortDescription": "WORKAPOS multisite point of sale terminal",
    "longDescription": "Touchscreen POS terminal with offline cache, network receipt printing and customer display.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
