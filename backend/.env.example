# WORKAPOS HQ — environment
# Copy this file to `.env` next to the backend binary or set the same
# variables in your systemd unit / container runtime.

# MySQL 8 connection string. Create the database first:
#   CREATE DATABASE workapos CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DATABASE_URL=mysql://root:root@127.0.0.1:3306/workapos

# Replace with a long random string in production (e.g. `openssl rand -hex 48`).
JWT_SECRET=change-me-before-production

# Bind address for the HQ API and admin UI.
BIND_ADDR=0.0.0.0:8080

# Static admin UI and uploaded display media.
WEB_DIR=./web
UPLOAD_DIR=./uploads

# Create demo brands/outlets/catalog/users on an empty database.
# Set to 0 for a clean production install.
SEED_DEMO=1

# PIN for the first administrator (NIK 1000). Only used when the admin
# account does not exist yet.
SEED_ADMIN_PIN=1234
